---
import ApartmentPage from '../../../components/pages/ApartmentPage.astro';
import { getBuildingApartments } from '../../../data/apartments';

export function getStaticPaths() {
	return getBuildingApartments('me', 'building1').map((apartment) => ({
		params: { apartment: apartment.id },
	}));
}

const { apartment } = Astro.params;

if (!apartment) {
	throw new Error('Missing apartment param');
}
---

<ApartmentPage buildingId="building1" apartmentId={apartment} />
