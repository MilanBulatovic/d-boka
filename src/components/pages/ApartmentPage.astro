---
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';
import BeforeAfterSlider from '../BeforeAfterSlider.astro';
import ApartmentRoomLayout from '../ApartmentRoomLayout.astro';
import { buildings, type BuildingId } from '../../data/buildings';
import { getApartmentById } from '../../data/apartments';
import { type Locale } from '../../i18n/config';
import { getRouteUrl } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';

interface Props {
	buildingId: BuildingId;
	apartmentId: string;
}

const { buildingId, apartmentId } = Astro.props;

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);
const building = buildings.find((item) => item.id === buildingId);
const apartment = getApartmentById(locale, buildingId, apartmentId);

if (!building || !apartment) {
	throw new Error(`Unknown apartment: ${buildingId}/${apartmentId}`);
}

const hasComparison = Boolean(apartment.beforeImage && apartment.afterImage);
---

<Layout>
	<Header overHero={false} />

	<main class="apartment-page">
		<div class="apartment-page__inner container">
			<a class="apartment-page__back" href={getRouteUrl(locale, building.routeId)}>
				<svg
					class="apartment-page__back-icon"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					aria-hidden="true"
				>
					<path
						d="M15 6L9 12L15 18"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="square"
						stroke-linejoin="round"></path>
				</svg>
				{t('apartments.backToBuilding')}
			</a>

			<div class="apartment-page__heading">
				<SectionHeading
					label={t('pages.home.residencies.label')}
					title={apartment.title}
					align="left"
				/>
			</div>

			<div class="apartment-page__tags">
				{
					apartment.sold && (
						<Button as="tag" variant="sold">
							{t('apartments.sold')}
						</Button>
					)
				}
				{
					apartment.reserved && (
						<Button as="tag" variant="reserved">
							{t('apartments.reserved')}
						</Button>
					)
				}
				{
					apartment.tags.map((tag) => (
						<span class="apartment-page__tag">{tag}</span>
					))
				}
			</div>

			{
				hasComparison && (
					<div class="apartment-page__slider">
						<BeforeAfterSlider
							beforeSrc={apartment.beforeImage!}
							afterSrc={apartment.afterImage!}
							beforeAlt={`${t('apartments.beforeAlt')} — ${apartment.title}`}
							afterAlt={`${t('apartments.afterAlt')} — ${apartment.title}`}
							label={t('a11y.beforeAfterSlider')}
						/>
					</div>
				)
			}

			{
				hasComparison && (
					<p class="apartment-page__disclaimer">{t('apartments.disclaimer')}</p>
				)
			}

			<div class="apartment-page__information">
				<SectionHeading
					label={t('apartments.information.label')}
					title={t('apartments.information.title')}
					align="left"
				/>

				<ApartmentRoomLayout
					options={apartment.options}
					planImage={apartment.planImage}
					planAlt={`${t('apartments.planAlt')} — ${apartment.title}`}
				/>
			</div>

		</div>
	</main>

	<Footer />
</Layout>

<style>
	.apartment-page {
		padding-top: 80px;
		background: var(--color-white);
		color: var(--color-nebula);
	}

	.apartment-page__inner {
		display: flex;
		flex-direction: column;
		gap: clamp(1.5rem, 3vw, 2.5rem);
		
		margin-inline: auto;
		padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 4rem);
	}

	.apartment-page__back {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		width: fit-content;
		font-family: var(--font-sans);
		font-size: 0.875rem;
		line-height: 1.4;
		color: var(--color-nebula);
		text-decoration: none;
		opacity: 0.7;
		transition: opacity 0.2s ease;
	}

	.apartment-page__back:hover {
		opacity: 1;
	}

	.apartment-page__back-icon {
		flex-shrink: 0;
	}



	.apartment-page__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.apartment-page__tag {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem 1.25rem;
		border-radius: 100px;
		background-color: var(--color-muted-gray);
		color: var(--color-greige);
		font-family: var(--font-sans);
		font-size: 0.875rem;
		line-height: 1.2;
	}

	.apartment-page__slider {
		width: 100%;
	}

	.apartment-page__disclaimer {
		margin: 0;
		margin-left: auto;
		margin-top: -1.5rem;
		max-width: 100%;

		font-family: var(--font-sans);
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--color-greige);
		text-align: right;
	}

	.apartment-page__information {
		display: flex;
		flex-direction: column;
		gap: clamp(1.5rem, 3vw, 2.5rem);
	}

	@media (max-width: 768px) {
		.apartment-page__disclaimer {
			text-align: left;
			margin-top: -1rem;
			margin-bottom:2rem;
		}
	}
</style>

<script>
	import { initScrollPageToTop } from '../../lib/scrollPageToTop';

	initScrollPageToTop('.apartment-page');
</script>
