---
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Layout from '../../layouts/Layout.astro';
import BuildingApartmentSection from '../BuildingApartmentSection.astro';
import BuildingApartmentsScroll from '../BuildingApartmentsScroll.astro';
import { buildings, type BuildingId } from '../../data/buildings';
import { getBuildingApartments } from '../../data/apartments';
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';

interface Props {
	buildingId: BuildingId;
}

const { buildingId } = Astro.props;

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);
const building = buildings.find((item) => item.id === buildingId);

if (!building) {
	throw new Error(`Unknown building: ${buildingId}`);
}

const apartments = getBuildingApartments(locale, buildingId);
---

<Layout>
	<Header overHero={false} />

	<main class="building-page">
		<BuildingApartmentsScroll>
			{
				apartments.map((apartment, index) => (
					<BuildingApartmentSection
						apartment={apartment}
						index={index}
						total={apartments.length}
						showHeading={index === 0}
						headingLabel={t('pages.home.residencies.label')}
						headingTitle={t(`pages.home.buildings.${buildingId}.title`)}
						showScrollDown={index === 0 && apartments.length > 1}
					/>
				))
			}
		</BuildingApartmentsScroll>
	</main>

	<Footer />
</Layout>

<style>
	.building-page {
		padding-top: 80px;
	}
</style>

<style is:global>
	.building-page {
		--building-heading-offset: -100px;
	}

	.building-apartment__heading {
		margin-top: var(--building-heading-offset);
		margin-bottom: clamp(1rem, 2vw, 2rem);
	}

	@media (max-width: 1024px) {
		.building-page {
			--building-heading-offset: 20px;
		}

		.building-apartment__heading {
			margin-bottom: 1rem;
		}
	}
</style>

<script>
	import { initScrollPageToTop } from '../../lib/scrollPageToTop';

	initScrollPageToTop('.building-page');

	function getBuildingHeadingOffset() {
		return window.matchMedia('(max-width: 1024px)').matches ? '20px' : '-100px';
	}

	function applyBuildingHeadingOffset() {
		const offset = getBuildingHeadingOffset();

		document.querySelectorAll<HTMLElement>('.building-page').forEach((page) => {
			page.style.setProperty('--building-heading-offset', offset);
		});

		document.querySelectorAll<HTMLElement>('.building-apartment__heading').forEach((heading) => {
			heading.style.marginTop = offset;
		});
	}

	function scheduleApplyBuildingHeadingOffset() {
		requestAnimationFrame(() => {
			requestAnimationFrame(applyBuildingHeadingOffset);
		});
	}

	scheduleApplyBuildingHeadingOffset();

	const win = window as Window & { __buildingHeadingOffsetHooked?: boolean };
	if (!win.__buildingHeadingOffsetHooked) {
		win.__buildingHeadingOffsetHooked = true;
		document.addEventListener('astro:page-load', scheduleApplyBuildingHeadingOffset);
		document.addEventListener('astro:after-swap', scheduleApplyBuildingHeadingOffset);
		document.addEventListener('building-apartments-scroll:ready', scheduleApplyBuildingHeadingOffset);
		window.addEventListener('resize', applyBuildingHeadingOffset, { passive: true });
	}
</script>
