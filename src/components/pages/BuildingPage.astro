---
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Layout from '../../layouts/Layout.astro';
import BuildingApartmentSection from '../BuildingApartmentSection.astro';
import BuildingApartmentsScroll from '../BuildingApartmentsScroll.astro';
import { buildings, type BuildingId } from '../../data/buildings';
import { getBuildingApartments } from '../../data/apartments';
import { type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';

interface Props {
	buildingId: BuildingId;
}

const { buildingId } = Astro.props;

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);
const building = buildings.find((item) => item.id === buildingId);

if (!building) {
	throw new Error(`Unknown building: ${buildingId}`);
}

const apartments = getBuildingApartments(locale, buildingId);
---

<Layout>
	<Header overHero={false} />

	<main class="building-page">
		<BuildingApartmentsScroll>
			{
				apartments.map((apartment, index) => (
					<BuildingApartmentSection
						apartment={apartment}
						index={index}
						total={apartments.length}
						showHeading={index === 0}
						headingLabel={t('pages.home.residencies.label')}
						headingTitle={t(`pages.home.buildings.${buildingId}.title`)}
						showScrollDown={index === 0 && apartments.length > 1}
					/>
				))
			}
		</BuildingApartmentsScroll>
	</main>

	<Footer />
</Layout>

<style>
	.building-page {
		padding-top: 80px;
	}
</style>
