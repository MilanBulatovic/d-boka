---
import logoLight from '../assets/light.svg';
import logoDark from '../assets/darko-logo.svg';
import LanguageSwitcher from './LanguageSwitcher.astro';
import HeaderBuildings from './HeaderBuildings.astro';
import { buildings } from '../data/buildings';
import { type Locale } from '../i18n/config';
import { getRouteUrl, type RouteId } from '../i18n/routes';
import { useTranslations } from '../i18n/utils';

interface Props {
	/** Početna: transparentan header preko heroa, bijeli logo. Ostale stranice: bijela pozadina, nebula tekst. */
	overHero?: boolean;
}

const { overHero = false } = Astro.props;

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

const nav: ReadonlyArray<{ routeId: RouteId; key: string }> = [
	{ routeId: 'home', key: 'nav.home' },
	{ routeId: 'about', key: 'nav.about' },
	{ routeId: 'contact', key: 'nav.contact' },
];

const homeHref = getRouteUrl(locale, 'home');
const navAfterResidencies = nav.filter((item) => item.routeId !== 'home');

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
	const normalized = href === '/' ? '/' : href.replace(/\/$/, '') || '/';
	if (normalized === '/') return pathname === '/';
	return pathname === normalized || pathname.startsWith(`${normalized}/`);
}

const residenciesActive = buildings.some((building) =>
	isActive(getRouteUrl(locale, building.routeId)),
);
---

<header
	id="site-header"
	class="site-header is-revealed"
	transition:persist="site-header"
	data-menu-open="false"
	data-revealed="true"
	data-scroll-dir="up"
	data-over-hero={overHero ? 'true' : 'false'}
	data-at-top={overHero ? 'true' : 'false'}
	data-solid={overHero ? 'false' : 'true'}
>
	<div class="site-header__bar container">
		<a class="site-header__logo" href={getRouteUrl(locale, 'home')} aria-label={t('a11y.home')}>
			<span class="site-header__logo-mark">
				<img class="site-header__logo-img site-header__logo-img--light" src={logoLight.src} width={84} height={70} alt="" />
				<img class="site-header__logo-img site-header__logo-img--dark" src={logoDark.src} width={84} height={70} alt="" />
			</span>
		</a>

		<nav class="site-header__nav site-header__nav--desktop" aria-label={t('a11y.navPrimary')}>
			<a
				class:list={['site-header__link', { 'is-active': isActive(homeHref) }]}
				href={homeHref}
				aria-current={isActive(homeHref) ? 'page' : undefined}
			>
				<span class="site-header__link-label">{t('nav.home')}</span>
			</a>

			<div class="site-header__nav-item site-header__nav-item--dropdown">
				<button
					type="button"
					class:list={[
						'site-header__link',
						'site-header__link--trigger',
						{ 'is-active': residenciesActive },
					]}
					aria-expanded="false"
					aria-haspopup="true"
				>
					<span class="site-header__link-label">{t('nav.residencies')}</span>
				</button>
				<div class="site-header__dropdown">
					<div class="site-header__dropdown-buildings">
						<HeaderBuildings locale={locale} variant="dropdown" pathname={pathname} />
					</div>
				</div>
			</div>

			{
				navAfterResidencies.map((item) => {
					const href = getRouteUrl(locale, item.routeId);
					return (
						<a
							class:list={['site-header__link', { 'is-active': isActive(href) }]}
							href={href}
							aria-current={isActive(href) ? 'page' : undefined}
						>
							<span class="site-header__link-label">{t(item.key)}</span>
						</a>
					);
				})
			}
		</nav>

		<div class="site-header__end">
			<LanguageSwitcher variant="desktop" />

			<button
				type="button"
				class="site-header__toggle"
				data-menu-toggle
				aria-expanded="false"
				aria-controls="mobile-nav"
				aria-label={t('a11y.openMenu')}
				data-label-open={t('a11y.openMenu')}
				data-label-close={t('a11y.closeMenu')}
			>
				<span class="site-header__icon site-header__icon--menu" aria-hidden="true">
					<svg width="29" height="26" viewBox="0 0 29 26" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M11 1H27.6667"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
						<path
							d="M1 12.6667H27.6667"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
						<path
							d="M1 24.3333H17.6667"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</span>
				<span class="site-header__icon site-header__icon--close" aria-hidden="true">
					<svg width="29" height="26" viewBox="0 0 29 26" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M2 2L27 24"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
						<path
							d="M27 2L2 24"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</span>
			</button>
		</div>
	</div>

	<div
		id="mobile-nav"
		class="site-header__drawer"
		hidden
		role="navigation"
		aria-label={t('a11y.navMobile')}
	>
		<nav class="site-header__drawer-inner">
			<div class="site-header__drawer-nav">
				{
					nav.map((item) => {
						const href = getRouteUrl(locale, item.routeId);
						return (
							<a
								class:list={['site-header__drawer-link', { 'is-active': isActive(href) }]}
								href={href}
								aria-current={isActive(href) ? 'page' : undefined}
							>
								{t(item.key)}
							</a>
						);
					})
				}
			</div>

			<div class="site-header__drawer-buildings">
				<HeaderBuildings locale={locale} variant="drawer" pathname={pathname} />
			</div>
			<div class="site-header__drawer-lang">
				<LanguageSwitcher variant="mobile" />
			</div>
		</nav>
	</div>
</header>

<style is:global>
	.site-header {
		--line: color-mix(in srgb, var(--ink) 12%, transparent);
		--accent: var(--color-nebula, #1f3a4a);
		--accent-soft: color-mix(in srgb, var(--accent) 10%, var(--paper));

		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		opacity: 0;
		transform: translate3d(0, calc(-100% - 0.4rem), 0);
		pointer-events: none;
		will-change: transform, opacity;
		transition:
			transform 0.34s cubic-bezier(0.55, 0, 1, 0.45),
			opacity 0.24s ease,
			background 0.32s ease,
			color 0.32s ease,
			border-color 0.32s ease,
			box-shadow 0.32s ease;
	}

	.site-header.is-revealed {
		opacity: 1;
		transform: translate3d(0, 0, 0);
		pointer-events: auto;
	}

	/* Scroll up — blaži ulazak */
	.site-header[data-scroll-dir='up'] {
		transition:
			transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
			opacity 0.42s cubic-bezier(0.16, 1, 0.3, 1) 0.06s,
			background 0.32s ease,
			color 0.32s ease,
			border-color 0.25s ease,
			box-shadow 0.32s ease;
	}

	/* Scroll down — brži, suptilan izlazak */
	.site-header[data-scroll-dir='down'] {
		transition:
			transform 0.32s cubic-bezier(0.55, 0, 1, 0.45),
			opacity 0.2s ease,
			border-color 0.25s ease;
	}

	.site-header__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1700px;
		margin: 0 auto;
		min-height: 3.5rem;
		padding: 0;
		will-change: transform, opacity;
		transition:
			transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
			opacity 0.4s ease;
	}

	.site-header:not(.is-revealed) .site-header__bar {
		transform: translateY(-0.2rem);
		opacity: 0.72;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.site-header__bar,
		.site-header__logo-img {
			transition: none;
		}

		.site-header:not(.is-revealed) .site-header__bar {
			transform: none;
			opacity: 1;
		}
	}

	@media (max-width: 768px) {
		/* .site-header__bar {
			padding: 0.65rem 2rem;
		} */
	}

	.site-header__logo {
		text-decoration: none;
		color: inherit;
		flex-shrink: 0;
	}

	.site-header__logo-mark {
		position: relative;
		display: block;
		width: clamp(3.25rem, 8vw, 4.25rem);
		aspect-ratio: 84 / 70;
		line-height: 0;
	}

	.site-header__logo-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		border-radius: 0;
		transition: opacity 0.32s ease;
	}

	.site-header__logo-img--light {
		opacity: 1;
	}

	.site-header__logo-img--dark {
		opacity: 0;
	}

	.site-header[data-solid='true'] .site-header__logo-img--light {
		opacity: 0;
	}

	.site-header[data-solid='true'] .site-header__logo-img--dark {
		opacity: 1;
	}

	/* Desktop navigacija — stilovi u global.css (view transitions) */

	.site-header__end {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-shrink: 0;
		margin-left: auto;
	}

	@media (min-width: 768px) {
		.site-header__end {
			margin-left: 0;
		}
	}

	/* CTA na desktopu — sakriven na mobilnom */
	.site-header__cta {
		align-items: center;
		gap: 0.45rem;
		padding: 0.5rem 0.85rem;
		border-radius: 6px;
		font-size: 0.68rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		text-decoration: none;
		border: 1px solid var(--paper);
		background: transparent;
		color: var(--paper);
		transition:
			background 0.32s ease,
			border-color 0.32s ease,
			color 0.32s ease,
			transform 0.2s ease;
	}

	.site-header[data-solid='true'] .site-header__cta {
		border-color: var(--ink);
		background: var(--ink);
		color: var(--paper);
	}

	.site-header__cta:hover {
		background: color-mix(in srgb, var(--paper) 14%, transparent);
		border-color: var(--paper);
		color: var(--paper);
	}

	.site-header[data-solid='true'] .site-header__cta:hover {
		background: color-mix(in srgb, var(--ink) 88%, var(--paper));
		border-color: var(--ink);
		color: var(--paper);
	}

	.site-header__cta--desktop {
		display: none;
	}

	@media (min-width: 768px) {
		.site-header__cta--desktop {
			display: inline-flex;
		}
	}

	/* Mobilni CTA u draweru */
	.site-header__cta--mobile {
		display: flex;
		margin-top: 0.5rem;
		justify-content: center;
		width: 100%;
		box-sizing: border-box;
		border-top: 1px solid var(--line);
		padding-top: 1rem;
		border-radius: 0;
		background: var(--ink);
		color: var(--paper);
	}

	.site-header__cta--mobile:hover {
		background: var(--accent);
		border-color: var(--accent);
	}

	@media (min-width: 768px) {
		.site-header__cta--mobile {
			display: none;
		}
	}

	.site-header__cta-arrow {
		opacity: 0.85;
	}

	/* Hamburger — samo <768px; isti izgled na svim stranicama */
	.site-header__toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: auto;
		height: auto;
		padding: 0;
		border: none;
		border-radius: 0;
		background: none;
		box-shadow: none;
		appearance: none;
		-webkit-appearance: none;
		color: var(--header-fg);
		cursor: pointer;
		transition: color 0.32s ease, opacity 0.2s ease;
	}

	.site-header__toggle:hover {
		opacity: 0.72;
	}

	.site-header__toggle:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--header-fg) 55%, transparent);
		outline-offset: 3px;
	}

	.site-header__icon {
		display: block;
		line-height: 0;
	}

	.site-header__icon svg {
		display: block;
		width: 29px;
		height: 26px;
	}

	.site-header__icon--close {
		display: none;
	}

	.site-header__toggle[aria-expanded='true'] .site-header__icon--menu {
		display: none;
	}

	.site-header__toggle[aria-expanded='true'] .site-header__icon--close {
		display: block;
	}

	@media (min-width: 768px) {
		.site-header__toggle {
			display: none;
		}
	}

	/* Drawer — samo mobilno; na desktopu uvek sakriven */
	.site-header__drawer {
		display: none;
		border-top: 1px solid var(--line);
		background: color-mix(in srgb, var(--paper) 96%, transparent);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		color: var(--ink);
	}

	@media (min-width: 768px) {
		.site-header__drawer {
			display: none !important;
		}
	}

	.site-header__drawer-inner {
		display: flex;
		flex-direction: column;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0.35rem 1.25rem 1.25rem;
	}
</style>

<script is:inline>
	const HEADER_PADDING_Y = '12px';

	function enforceHeaderLayout(header) {
		if (!header) return;
		header.style.setProperty('padding-top', HEADER_PADDING_Y);
		header.style.setProperty('padding-bottom', HEADER_PADDING_Y);
		const bar = header.querySelector('.site-header__bar');
		if (bar) {
			bar.style.setProperty('padding-top', '0');
			bar.style.setProperty('padding-bottom', '0');
		}
		header.style.setProperty('--header-bar-height', `${header.offsetHeight}px`);
	}

	function syncHeaderBarHeight() {
		const header = document.getElementById('site-header');
		if (!header) return;
		enforceHeaderLayout(header);
	}

	function syncHeaderTheme(header, y) {
		const topZone = 48;
		const overHero = header.dataset.overHero === 'true';

		if (!overHero) {
			header.dataset.atTop = 'false';
			header.dataset.solid = 'true';
			return;
		}

		const atTop = y <= topZone;
		const menuOpen = header.dataset.menuOpen === 'true';
		const headerRevealed = header.dataset.revealed === 'true';
		const solid = menuOpen || (!atTop && headerRevealed);

		header.dataset.atTop = atTop ? 'true' : 'false';
		header.dataset.solid = solid ? 'true' : 'false';
	}

	function syncHeaderReveal(header) {
		const topZone = 48;
		const y = window.scrollY;
		const revealed = y <= topZone || header.dataset.menuOpen === 'true';
		if (revealed) header.dataset.scrollDir = 'up';
		header.classList.toggle('is-revealed', revealed);
		header.dataset.revealed = revealed ? 'true' : 'false';
		syncHeaderTheme(header, y);
		header.dataset.scrollLastY = String(y);
	}

	function updateHeaderScroll(header) {
		const scrollThreshold = 10;
		const topZone = 48;
		const y = window.scrollY;
		const lastY = Number(header.dataset.scrollLastY ?? y);
		const delta = y - lastY;

		function setRevealed(revealed, direction) {
			if (direction) header.dataset.scrollDir = direction;
			header.classList.toggle('is-revealed', revealed);
			header.dataset.revealed = revealed ? 'true' : 'false';
		}

		if (header.dataset.menuOpen === 'true') {
			setRevealed(true, 'up');
			syncHeaderTheme(header, y);
			header.dataset.scrollLastY = String(y);
			return;
		}

		if (y <= topZone) {
			setRevealed(true, 'up');
		} else if (delta > scrollThreshold) {
			setRevealed(false, 'down');
		} else if (delta < -scrollThreshold) {
			setRevealed(true, 'up');
		}

		syncHeaderTheme(header, y);
		header.dataset.scrollLastY = String(y);
	}

	function attachHeaderScroll() {
		const header = document.getElementById('site-header');
		if (!header) return;

		if (window.__headerScrollBound !== '1') {
			window.__headerScrollBound = '1';
			let ticking = false;

			window.addEventListener(
				'scroll',
				() => {
					if (ticking) return;
					ticking = true;
					requestAnimationFrame(() => {
						const currentHeader = document.getElementById('site-header');
						if (currentHeader) updateHeaderScroll(currentHeader);
						ticking = false;
					});
				},
				{ passive: true },
			);
		}

		syncHeaderReveal(header);
	}

	function setMobileMenuOpen(header, open) {
		const btn = header.querySelector('[data-menu-toggle]');
		const panel = header.querySelector('#mobile-nav');
		if (!btn || !panel) return;

		header.dataset.menuOpen = open ? 'true' : 'false';
		if (open) {
			header.classList.add('is-revealed');
			header.dataset.revealed = 'true';
			header.dataset.scrollDir = 'up';
		}
		btn.setAttribute('aria-expanded', String(open));
		btn.setAttribute(
			'aria-label',
			open ? btn.dataset.labelClose ?? 'Close menu' : btn.dataset.labelOpen ?? 'Open menu',
		);
		panel.hidden = !open;
		document.body.style.overflow = open ? 'hidden' : '';
		syncHeaderTheme(header, window.scrollY);
	}

	function resetMobileMenu() {
		document.body.style.overflow = '';
		const header = document.getElementById('site-header');
		if (header) setMobileMenuOpen(header, false);
	}

	function attachMobileMenu() {
		if (window.__mobileMenuBound === '1') return;
		window.__mobileMenuBound = '1';

		document.addEventListener('click', (event) => {
			const toggle = event.target.closest('[data-menu-toggle]');
			if (toggle) {
				const header = toggle.closest('#site-header');
				if (!header) return;
				setMobileMenuOpen(header, header.dataset.menuOpen !== 'true');
				return;
			}

			const drawerLink = event.target.closest('#mobile-nav a');
			if (drawerLink) {
				const header = drawerLink.closest('#site-header');
				if (header) setMobileMenuOpen(header, false);
			}
		});

		window.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			const header = document.getElementById('site-header');
			if (header?.dataset.menuOpen === 'true') setMobileMenuOpen(header, false);
		});

		matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
			if (!event.matches) return;
			const header = document.getElementById('site-header');
			if (header) setMobileMenuOpen(header, false);
		});
	}

	function initHeader() {
		resetMobileMenu();
		syncHeaderBarHeight();
		attachHeaderScroll();
		requestAnimationFrame(syncHeaderBarHeight);
	}

	function syncHeaderSection(incoming, header, selector) {
		const newEl = incoming.querySelector(selector);
		const oldEl = header.querySelector(selector);
		if (newEl && oldEl) oldEl.innerHTML = newEl.innerHTML;
	}

	function syncHeaderFromIncomingPage(event) {
		const incoming = event.newDocument?.getElementById('site-header');
		const header = document.getElementById('site-header');
		if (!incoming || !header) return;

		header.dataset.overHero = incoming.dataset.overHero ?? 'false';
		header.dataset.atTop = incoming.dataset.atTop ?? 'false';

		const newLogo = incoming.querySelector('.site-header__logo');
		const oldLogo = header.querySelector('.site-header__logo');
		if (newLogo && oldLogo) {
			const href = newLogo.getAttribute('href');
			if (href) oldLogo.setAttribute('href', href);
			const label = newLogo.getAttribute('aria-label');
			if (label) oldLogo.setAttribute('aria-label', label);
		}

		syncHeaderSection(incoming, header, '.site-header__nav--desktop');
		syncHeaderSection(incoming, header, '.site-header__drawer-nav');
		syncHeaderSection(incoming, header, '.site-header__drawer-buildings');

		const newEnd = incoming.querySelector('.site-header__end');
		const oldEnd = header.querySelector('.site-header__end');
		if (newEnd && oldEnd) oldEnd.innerHTML = newEnd.innerHTML;

		enforceHeaderLayout(header);
	}

	function syncHeaderAfterNavigation() {
		const header = document.getElementById('site-header');
		if (!header) return;
		enforceHeaderLayout(header);
		syncHeaderReveal(header);
	}

	function onBeforeSwap(event) {
		resetMobileMenu();
		syncHeaderFromIncomingPage(event);
	}

	attachMobileMenu();
	initHeader();

	window.addEventListener('resize', syncHeaderBarHeight, { passive: true });
	document.addEventListener('astro:before-swap', onBeforeSwap);
	document.addEventListener('astro:after-swap', syncHeaderAfterNavigation);
	document.addEventListener('astro:page-load', initHeader);
</script>
