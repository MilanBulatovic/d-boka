---
import en from '../i18n/locales/en.json';
import me from '../i18n/locales/me.json';
import enterierImage from '../assets/enterier-image.webp';
import IoImage from './IoImage.astro';
import SectionHeading from './SectionHeading.astro';
import { type Locale } from '../i18n/config';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

type Props = {
	locale?: Locale;
};

const locale = (Astro.props.locale ?? Astro.currentLocale ?? getLocaleFromUrl(Astro.url)) as Locale;
const t = useTranslations(locale);
const dict = locale === 'me' ? me : en;
const leftColumn = dict.pages.home.benefits.columns.left;
const rightColumn = dict.pages.home.benefits.columns.right;
---

<section class="benefits-section">
	<div class="benefits-section__grid">
		<div class="benefits-section__media">
			<IoImage
				src={enterierImage}
				alt={t('pages.home.benefits.imageAlt')}
				class="benefits-section__image"
				width={960}
				height={900}
			/>
		</div>

			<div class="container">
		<div class="benefits-section__content">
			<SectionHeading
				label={t('pages.home.benefits.label')}
				title={t('pages.home.benefits.title')}
				align="left"
			/>

			<div class="benefits-section__lists">
				<ul class="benefits-section__list">
					{leftColumn.map((item) => (
						<li>{item}</li>
					))}
				</ul>
				<ul class="benefits-section__list">
					{rightColumn.map((item) => (
						<li>{item}</li>
					))}
				</ul>
			</div>
		</div>
		</div>
	</div>
</section>

<style>
	.benefits-section {
		background-color: var(--color-white);
	}

	.benefits-section__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: clamp(28rem, 50vw, 42rem);
	}

	.benefits-section__media {
		position: relative;
		min-height: 100%;
		height: 900px;
		overflow: hidden;
	}

	.benefits-section__media :global(.io-image-watch),
	.benefits-section__media :global(.io-image-frame) {
		height: 100%;
		border-radius: 0;
	}

	.benefits-section__media :global(.io-image) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		border-radius: 0;
	}

	.benefits-section__content {
	    display: flex;
		flex-direction: column;
		justify-content: end;
		gap: 3rem;
		padding: clamp(3rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem);
		padding-bottom: 0;
		height: 100%;
		margin-top: auto;
	}

	.benefits-section__lists {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(1.5rem, 3vw, 2.5rem);
	}

	.benefits-section__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.benefits-section__list li {
		position: relative;
		padding-left: 1.25rem;
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: clamp(0.95rem, 1.25vw, 1.125rem);
		line-height: 140%;
		color: rgba(18, 18, 18, 0.7);
	}

	.benefits-section__list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.65em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background-color: var(--color-nebula);
		transform: translateY(-50%);
	}

	@media (max-width: 768px) {
		.benefits-section__grid {
			grid-template-columns: 1fr;
			min-height: auto;
		
		}

		.benefits-section__media {
			height: 400px;
		}

		.benefits-section__content {
			padding: clamp(2.5rem, 8vw, 3.5rem) var(--container-padding, 1.25rem);
			gap:2rem;
		}

		.benefits-section__lists {
			grid-template-columns: 1fr;
			gap: 0.2rem;
		}
	}
</style>
