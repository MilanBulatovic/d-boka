---
---
<div class="building-apartments-scroll" data-building-apartments-scroll>
	<slot />
</div>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	type WindowWithStack = Window & {
		__buildingApartmentsScrollHooked?: boolean;
		__buildingApartmentsScrollTriggers?: ScrollTrigger[];
		__buildingApartmentsScrollResizeTimer?: number;
	};

	function getTriggerStore() {
		const win = window as WindowWithStack;
		if (!win.__buildingApartmentsScrollTriggers) win.__buildingApartmentsScrollTriggers = [];
		return win.__buildingApartmentsScrollTriggers;
	}

	function getHeaderOffset(): number {
		const header = document.getElementById('site-header');
		return header?.offsetHeight ?? 80;
	}

	function resetPinnedPanel(panel: HTMLElement) {
		gsap.set(panel, { clearProps: 'zIndex,transform,top,left,width,maxWidth,position,boxSizing,marginTop' });
	}

	function killBuildingApartmentsScrollTriggers() {
		const store = getTriggerStore();
		for (const trigger of store) trigger.kill();
		store.length = 0;

		document.querySelectorAll<HTMLElement>('[data-building-apartments-scroll]').forEach((wrapper) => {
			delete wrapper.dataset.buildingApartmentsReady;
			wrapper.dataset.stackActive = 'false';
			wrapper.querySelectorAll<HTMLElement>('.building-apartment').forEach(resetPinnedPanel);
		});
	}

	function initBuildingApartmentsScroll() {
		killBuildingApartmentsScrollTriggers();

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		ScrollTrigger.config({ ignoreMobileResize: true });

		const headerOffset = getHeaderOffset();
		const pinStart = `top top+=${headerOffset}`;

		document.querySelectorAll<HTMLElement>('[data-building-apartments-scroll]').forEach((wrapper) => {
			if (wrapper.dataset.buildingApartmentsReady === 'true') return;

			const panels = gsap.utils.toArray<HTMLElement>('.building-apartment', wrapper);
			if (panels.length < 2) {
				wrapper.dataset.buildingApartmentsReady = 'true';
				return;
			}

			wrapper.dataset.stackActive = 'true';
			const lastPanel = panels[panels.length - 1];

			panels.forEach((panel, index) => {
				gsap.set(panel, { zIndex: index + 1 });

				const pinTrigger = ScrollTrigger.create({
					trigger: panel,
					start: pinStart,
					pin: true,
					pinSpacing: index === panels.length - 1,
					pinType: 'fixed',
					endTrigger: lastPanel,
					end: 'bottom bottom',
					invalidateOnRefresh: true,
					anticipatePin: 1,
				});

				getTriggerStore().push(pinTrigger);
			});

			wrapper.dataset.buildingApartmentsReady = 'true';
		});

		ScrollTrigger.refresh();

		document.dispatchEvent(new CustomEvent('building-apartments-scroll:ready'));
	}

	function scheduleInit() {
		requestAnimationFrame(() => {
			requestAnimationFrame(initBuildingApartmentsScroll);
		});
	}

	function onResize() {
		const win = window as WindowWithStack;
		clearTimeout(win.__buildingApartmentsScrollResizeTimer);
		win.__buildingApartmentsScrollResizeTimer = window.setTimeout(scheduleInit, 200);
	}

	scheduleInit();

	const win = window as WindowWithStack;
	if (!win.__buildingApartmentsScrollHooked) {
		win.__buildingApartmentsScrollHooked = true;
		document.addEventListener('astro:page-load', scheduleInit);
		document.addEventListener('astro:before-swap', killBuildingApartmentsScrollTriggers);
		window.addEventListener('resize', onResize, { passive: true });
		window.addEventListener('orientationchange', onResize, { passive: true });
	}
</script>

<style>
	.building-apartments-scroll {
		position: relative;
	}

	.building-apartments-scroll[data-stack-active='true'] :global(.building-apartment) {
		position: relative;
		min-height: 100dvh;
		min-height: 100svh;
	}

	.building-apartments-scroll[data-stack-active='true'] :global(.building-apartment__grid) {
		min-height: 100dvh;
		min-height: 100svh;
	}

	.building-apartments-scroll[data-stack-active='true'] :global(.building-apartment:not(:first-child)) {
		box-shadow: 0 -16px 48px color-mix(in srgb, var(--color-nebula) 10%, transparent);
	}

	@media (max-width: 1024px) {
		.building-apartments-scroll[data-stack-active='true'] :global(.building-apartment__grid) {
			grid-template-rows: minmax(0, 42svh) minmax(0, 1fr);
		}

		.building-apartments-scroll[data-stack-active='true'] :global(.building-apartment__media) {
			min-height: 0;
			padding: 1.25rem;
			padding-top: 0;
		}

		.building-apartments-scroll[data-stack-active='true'] :global(.building-apartment__text) {
			min-height: 0;
			overflow: visible;
			padding: 1.5rem 1.25rem 2rem;
		}

		.building-apartments-scroll[data-stack-active='true'] :global(.building-apartment__scroll) {
			bottom: 3%;
		}
	}
</style>
