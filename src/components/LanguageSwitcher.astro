---
import { languages, locales, type Locale } from '../i18n/config';
import { getRouteIdFromUrl, getRouteUrl } from '../i18n/routes';
import { useTranslations } from '../i18n/utils';

interface Props {
	variant?: 'desktop' | 'mobile';
}

const { variant = 'desktop' } = Astro.props;

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);
const routeId = getRouteIdFromUrl(Astro.url);

function localeHref(target: Locale) {
	return getRouteUrl(target, routeId);
}
---

<div
	class:list={['lang-switcher', `lang-switcher--${variant}`]}
	role="group"
	aria-label={t('a11y.languageSwitcher')}
>
	<svg
		class="lang-switcher__icon"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<path
			d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z"
			stroke="currentColor"
			stroke-width="1.2"></path>
		<path
			d="M8 12C8 18 12 22 12 22C12 22 16 18 16 12C16 6 12 2 12 2C12 2 8 6 8 12Z"
			stroke="currentColor"
			stroke-width="1.2"
			stroke-linejoin="round"></path>
		<path
			d="M21 15H3"
			stroke="currentColor"
			stroke-width="1.2"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
		<path
			d="M21 9H3"
			stroke="currentColor"
			stroke-width="1.2"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
	</svg>

	<ul class="lang-switcher__list">
		{
			locales.map((code) => (
				<li class="lang-switcher__item">
					<a
						class:list={['lang-switcher__link', { 'is-active': code === locale }]}
						href={localeHref(code)}
						hreflang={code}
						lang={code}
						aria-current={code === locale ? 'true' : undefined}
						aria-label={`${languages[code]}${code === locale ? ` (${t('a11y.currentLanguage')})` : ''}`}
					>
						{t(`lang.${code}`)}
					</a>
				</li>
			))
		}
	</ul>
</div>

<style>
	.lang-switcher {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 0.75rem;
		border-radius: 6px;
		border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
		background: color-mix(in srgb, currentColor 6%, transparent);
		color: inherit;
	}

	.lang-switcher--mobile {
		display: flex;
		justify-content: center;
		width: 100%;
		box-sizing: border-box;
		margin-top: 0.5rem;
		padding: 0.75rem 1rem;
		border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent);
		border-radius: 0;
	}

	.lang-switcher__icon {
		flex-shrink: 0;
		display: block;
	}

	.lang-switcher__list {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.lang-switcher__item {
		display: flex;
	}

	.lang-switcher__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2rem;
		padding: 0.2rem 0.35rem;
		border-radius: 4px;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-decoration: none;
		color: color-mix(in srgb, currentColor 72%, transparent);
		transition:
			background 0.18s ease,
			color 0.18s ease;
	}

	.lang-switcher__link:hover {
		color: inherit;
		background: color-mix(in srgb, currentColor 10%, transparent);
	}

	.lang-switcher__link.is-active {
		color: inherit;
		background: color-mix(in srgb, currentColor 14%, transparent);
	}

	.lang-switcher--desktop {
		display: none;
	}

	@media (min-width: 768px) {
		.lang-switcher--desktop {
			display: inline-flex;
		}

		.lang-switcher--mobile {
			display: none;
		}
	}
</style>
