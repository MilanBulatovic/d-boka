---
import { languages, locales, type Locale } from '../i18n/config';
import { getLocalizedUrl } from '../i18n/routes';
import { useTranslations } from '../i18n/utils';

interface Props {
	variant?: 'desktop' | 'mobile';
}

const { variant = 'desktop' } = Astro.props;

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

function localeHref(target: Locale) {
	return getLocalizedUrl(Astro.url, target);
}
---

<div
	class:list={['lang-switcher', `lang-switcher--${variant}`]}
	role="group"
	aria-label={t('a11y.languageSwitcher')}
>
	<div class="lang-switcher__inner">
		<svg
		class="lang-switcher__icon"
		width="24"
		height="24"
		viewBox="0 0 24 24"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<path
			d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z"
			stroke="currentColor"
			stroke-width="1.2"></path>
		<path
			d="M8 12C8 18 12 22 12 22C12 22 16 18 16 12C16 6 12 2 12 2C12 2 8 6 8 12Z"
			stroke="currentColor"
			stroke-width="1.2"
			stroke-linejoin="round"></path>
		<path
			d="M21 15H3"
			stroke="currentColor"
			stroke-width="1.2"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
		<path
			d="M21 9H3"
			stroke="currentColor"
			stroke-width="1.2"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
	</svg>

	<ul class="lang-switcher__list">
		{
			locales.map((code) => (
				<li class="lang-switcher__item">
					<a
						class:list={['lang-switcher__link', { 'is-active': code === locale }]}
						href={localeHref(code)}
						hreflang={code}
						lang={code}
						aria-current={code === locale ? 'true' : undefined}
						aria-label={`${languages[code]}${code === locale ? ` (${t('a11y.currentLanguage')})` : ''}`}
					>
						{t(`lang.${code}`)}
					</a>
				</li>
			))
		}
		</ul>
	</div>
	{variant === 'mobile' && <p class="lang-switcher__drawer-logo">D One Boka Residence</p>}
</div>
