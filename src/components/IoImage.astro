---
/**
 * Učitava optimiziranu sliku tek kad uđe u viewport (IntersectionObserver).
 * Browserov `loading="lazy"` i dalje može učitati daleko ispod ekrana — ovo je striktnije.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	alt: string;
	class?: string;
	sizes?: string;
	/** Hero / LCP: pravi src odmah u HTML-u (eager + fetchpriority high). Bez ovoga IO čeka viewport — može odložiti LCP. */
	priority?: boolean;
	/** @see https://developer.mozilla.org/en-US/docs/Web/API/HTMLImageElement/fetchPriority */
	fetchpriority?: 'high' | 'low' | 'auto';
}

const {
	src: meta,
	alt,
	class: className,
	sizes = '(max-width: 768px) 100vw, min(72rem, 92vw)',
	priority = false,
	fetchpriority: fetchpriorityProp,
} = Astro.props;

const fetchpriority = fetchpriorityProp ?? (priority ? 'high' : 'low');

const preset = [480, 720, 960, 1200, 1600];
const widths = [...new Set([...preset.filter((w) => w <= meta.width), meta.width])].sort((a, b) => a - b);

const optimized = await getImage({
	src: meta,
	format: 'webp',
	widths,
	sizes,
});

const w = meta.width;
const h = meta.height;
const svgMarkup =
	'<svg xmlns="http://www.w3.org/2000/svg" width="' +
	w +
	'" height="' +
	h +
	'" viewBox="0 0 ' +
	w +
	' ' +
	h +
	'"><rect fill="#e8e4dc" width="100%" height="100%"></rect></svg>';
const placeholder = 'data:image/svg+xml,' + encodeURIComponent(svgMarkup);
---

<div class="io-image-watch" data-io-watch>
	<span class="io-image-frame">
		{
			priority ? (
				<img
					class:list={['io-image', className]}
					src={optimized.src}
					srcset={optimized.srcSet.attribute}
					sizes={sizes}
					width={optimized.attributes.width}
					height={optimized.attributes.height}
					alt={alt}
					loading="eager"
					decoding="sync"
					fetchpriority={fetchpriority}
					data-io-priority="true"
				/>
			) : (
				<img
					class:list={['io-image', className]}
					src={placeholder}
					width={optimized.attributes.width}
					height={optimized.attributes.height}
					alt={alt}
					decoding="async"
					fetchpriority={fetchpriority}
					data-resolved-src={optimized.src}
					data-resolved-srcset={optimized.srcSet.attribute}
					data-resolved-sizes={sizes}
				/>
			)
		}
	</span>
</div>

<script>
	import gsap from 'gsap';

	function revealFromTop(img: HTMLImageElement) {
		const frame = img.closest('.io-image-frame');
		if (!frame) return;

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			gsap.set(frame, { clearProps: 'clipPath' });
			return;
		}

		gsap.fromTo(
			frame,
			{ clipPath: 'inset(0 0 100% 0)' },
			{
				clipPath: 'inset(0 0 0% 0)',
				duration: 0.72,
				ease: 'power2.out',
				immediateRender: true,
				onComplete: () => {
					gsap.set(frame, { clearProps: 'clipPath' });
				},
			},
		);
	}

	function afterDecoded(img: HTMLImageElement, fn: () => void) {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			fn();
			return;
		}
		let done = false;
		const run = () => {
			if (done) return;
			done = true;
			fn();
		};
		img.addEventListener('load', run, { once: true });
		img.addEventListener('error', run, { once: true });
		if (img.decode) {
			img.decode().then(run).catch(() => run());
		}
		requestAnimationFrame(() => {
			if (img.complete && img.naturalWidth > 0) run();
		});
	}

	function bindIoImage(el: Element) {
		if (!(el instanceof HTMLImageElement)) return;
		const image = el;
		if (image.getAttribute('data-io-bound') === '1') return;
		const realSrc = image.getAttribute('data-resolved-src');
		if (!realSrc) return;
		image.setAttribute('data-io-bound', '1');
		const resolvedUrl = realSrc;

		function apply() {
			const srcset = image.getAttribute('data-resolved-srcset');
			const sizez = image.getAttribute('data-resolved-sizes');
			image.src = resolvedUrl;
			if (srcset) image.setAttribute('srcset', srcset);
			if (sizez) image.setAttribute('sizes', sizez);
			image.removeAttribute('data-resolved-src');
			image.removeAttribute('data-resolved-srcset');
			image.removeAttribute('data-resolved-sizes');
			afterDecoded(image, () => revealFromTop(image));
		}

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			apply();
			return;
		}

		const watch = image.closest('[data-io-watch]');
		const obsTarget = watch instanceof HTMLElement ? watch : image;

		const obs = new IntersectionObserver(
			(entries, o) => {
				for (let i = 0; i < entries.length; i++) {
					if (!entries[i].isIntersecting) continue;
					apply();
					o.disconnect();
					break;
				}
			},
			{ root: null, rootMargin: '0px', threshold: 0 },
		);
		obs.observe(obsTarget);
	}

	function initIoImagePriorityReveal() {
		document.querySelectorAll('img[data-io-priority]').forEach((img) => {
			if (!(img instanceof HTMLImageElement)) return;
			if (img.getAttribute('data-io-reveal-bound') === '1') return;
			img.setAttribute('data-io-reveal-bound', '1');
			afterDecoded(img, () => revealFromTop(img));
		});
	}

	function initIoImages() {
		document.querySelectorAll('img[data-resolved-src]').forEach(bindIoImage);
		initIoImagePriorityReveal();
	}

	initIoImages();
	const win = window as Window & { __ioImageNavHooked?: boolean };
	if (!win.__ioImageNavHooked) {
		win.__ioImageNavHooked = true;
		document.addEventListener('astro:page-load', initIoImages);
	}
</script>

<style>
	/* Bez clip-path ovdje: inače IO na <img> vidi presjek 0 i nikad ne okine apply(). */
	.io-image-watch {
		display: block;
		width: 100%;
	}

	.io-image-frame {
		display: block;
		width: 100%;
		background: #ffffff;
		overflow: hidden;
		border-radius: inherit;
	}

	.io-image {
		width: 100%;
		height: auto;
	}
</style>
